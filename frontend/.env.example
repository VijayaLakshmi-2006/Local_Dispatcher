VITE_API_URL=http://localhost:5000

# Google Identity Services Configuration
VITE_GOOGLE_CLIENT_ID=

# How to setup Real Google Sign-In for localhost:
# 1. Create/select Google Cloud project
# 2. Configure OAuth consent screen
# 3. Create Web application OAuth client
# 4. Add localhost authorized JavaScript origin (e.g. http://localhost:3000)
# 5. Copy Client ID
# 6. Put it in frontend/.env (VITE_GOOGLE_CLIENT_ID)
# 7. Restart Vite
# Never put GOOGLE_CLIENT_SECRET in frontend .env.
